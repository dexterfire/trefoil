<?xml version="1.0" encoding="utf-8"?>
<!-- Per-app language (Android 13+): Russian is the product default, English is the second locale.
     Referenced by android:localeConfig on <application> in AndroidManifest.xml. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ru" />
    <locale android:name="en" />
</locale-config>
